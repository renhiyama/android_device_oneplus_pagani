     <string name="charging_control_mode_auto_summary">Automatically determine when to start charging based on alarms set</string>
diff --git a/res/xml/charging_control_settings.xml b/res/xml/charging_control_settings.xml
index 850394b..f14b2f7 100644
--- a/res/xml/charging_control_settings.xml
+++ b/res/xml/charging_control_settings.xml
@@ -11,6 +11,24 @@
         android:key="charging_control_enabled"
         android:title="@string/charging_control_enable_title" />
 
+    <!-- Manual bypass-charging override. Independent of the auto Charging
+         Control flow; flips a separate setting that the framework controller
+         picks up via ContentObserver. -->
+    <lineageos.preference.LineageSystemSettingSwitchPreference
+        android:key="bypass_charging_enabled"
+        android:title="@string/bypass_charging_title"
+        android:summary="@string/bypass_charging_summary" />
+
+    <!-- True Bypass: layered on top of normal Bypass. Calls OPLUS Smart
+         Charge Protection (flag 14) to fully open the battery FET.
+         Auto-disables at 20% SoC. android:dependency greys it out when
+         normal Bypass is off. -->
+    <lineageos.preference.LineageSystemSettingSwitchPreference
+        android:key="true_bypass_charging_enabled"
+        android:title="@string/true_bypass_charging_title"
+        android:summary="@string/true_bypass_charging_summary"
+        android:dependency="bypass_charging_enabled" />
+
     <lineageos.preference.LineageSystemSettingListPreference
         android:key="charging_control_mode"
         android:title="@string/charging_control_mode_title"
