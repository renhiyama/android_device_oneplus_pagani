     <!-- Charging control settings -->
     <string name="charging_control_title">Charging control</string>
     <string name="charging_control_enable_title">Enable charging control</string>
+    <!-- Bypass charging: device runs from external power while the battery FET is held open. -->
+    <string name="bypass_charging_title">Bypass charging</string>
+    <string name="bypass_charging_summary">Run the device directly from the charger while keeping the battery at its current level. Useful for gaming or sustained heavy load to reduce battery wear and heat.</string>
+    <!-- True Bypass: layered on top of normal Bypass. Auto-disables at 20% SoC. -->
+    <string name="true_bypass_charging_title">True bypass charging</string>
+    <string name="true_bypass_charging_summary">Fully isolate the battery — USB powers the device, battery neither charges nor drains. Auto-disables at 20% to keep the phone running. Requires bypass charging above.</string>
