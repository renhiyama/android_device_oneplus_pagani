+    private static final String BYPASS_CHARGING_NODE = "/sys/class/oplus_chg/common/plc";
+    private static final String BYPASS_CHARGING_ACTIVE_VALUE = "status=3";
+
+    private boolean isBypassChargingActive() {
+        // PLC node exposes the OPLUS bypass state on supported devices.
+        // Non-OPLUS hardware: the file simply won't exist and we return false.
+        java.io.File node = new java.io.File(BYPASS_CHARGING_NODE);
+        if (!node.exists()) {
+            return false;
+        }
+        try (java.io.BufferedReader reader =
+                     new java.io.BufferedReader(new java.io.FileReader(node))) {
+            String line = reader.readLine();
+            return line != null && line.trim().equals(BYPASS_CHARGING_ACTIVE_VALUE);
+        } catch (java.io.IOException e) {
+            return false;
+        }
+    }
+
     public void setStatusBarKeyguardViewManager(
             StatusBarKeyguardViewManager statusBarKeyguardViewManager) {
         mStatusBarKeyguardViewManager = statusBarKeyguardViewManager;
