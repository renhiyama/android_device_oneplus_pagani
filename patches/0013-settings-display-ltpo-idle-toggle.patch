+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Controls the "Reduce idle display power" toggle on pagani.
+ *
+ * Sets persist.sys.pagani_ltpo_idle which is consumed by
+ * init.pagani-ltpo.rc — the init trigger writes the appropriate
+ * adfr_config bitmap to /sys/kernel/oplus_display/adfr_config so the panel
+ * can drop the MIPI link entirely on truly static content.
+ *
+ * Hidden on non-pagani devices via getAvailabilityStatus.
+ */
+public class PaganiLtpoIdleController extends TogglePreferenceController {
+
+    private static final String IDLE_PROP = "persist.sys.pagani_ltpo_idle";
+    private static final String DEVICE_PROP = "ro.product.device";
+
+    public PaganiLtpoIdleController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        final String device = SystemProperties.get(DEVICE_PROP, "");
+        // pagani ships under two SKUs: OP612BL1 (India / 13s) and
+        // OP60F5L1 (China / 13T). Same panel, same ADFR engine.
+        if ("OP612BL1".equals(device) || "OP60F5L1".equals(device)) {
+            return AVAILABLE;
+        }
+        return UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return SystemProperties.getBoolean(IDLE_PROP, false);
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        SystemProperties.set(IDLE_PROP, isChecked ? "1" : "0");
+        return true;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return com.android.settings.R.string.menu_key_display;
+    }
+}
