+        private boolean callOplusSetChgConfig(int flag, String extra, int caller) {
+            android.os.IBinder binder = android.os.ServiceManager.getService(
+                    "vendor.oplus.hardware.charger.ICharger/default");
+            if (binder == null) {
+                Log.w(TAG, "OPLUS charger HAL not available");
+                return false;
+            }
+            android.os.Parcel data = android.os.Parcel.obtain();
+            android.os.Parcel reply = android.os.Parcel.obtain();
+            try {
+                data.writeInterfaceToken(
+                        "vendor.oplus.hardware.charger.ICharger");
+                data.writeInt(flag);
+                data.writeString(extra);
+                data.writeInt(caller);
+                // 127 = TRANSACTION_setChgConfig in the V10 ICharger AIDL.
+                if (!binder.transact(127, data, reply, 0)) {
+                    Log.e(TAG, "setChgConfig transact returned false");
+                    return false;
+                }
+                reply.readException();
+                int result = reply.readInt();
+                Log.i(TAG, "OPLUS setChgConfig(" + flag + ", " + extra
+                        + ", " + caller + ") = " + result);
+                return result == 0;
+            } catch (android.os.RemoteException | RuntimeException e) {
+                Log.e(TAG, "OPLUS setChgConfig failed", e);
+                return false;
+            } finally {
+                reply.recycle();
+                data.recycle();
+            }
+        }
