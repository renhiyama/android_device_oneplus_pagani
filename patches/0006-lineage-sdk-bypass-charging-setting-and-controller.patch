+        @Override
+        public boolean isBypassChargingActive() {
+            // Ground truth: USB plugged AND battery not actually charging.
+            // PLC `status` is unreliable (always reads 3 once charger plugged);
+            // battery/current_now is heavily cached. battery/status is the
+            // simplest signal that flips reliably when the FET opens.
+            try {
+                java.io.File usbOnline =
+                        new java.io.File("/sys/class/power_supply/usb/online");
+                java.io.File batStatus =
+                        new java.io.File("/sys/class/power_supply/battery/status");
+                if (!usbOnline.exists() || !batStatus.exists()) {
+                    return false;
+                }
+                try (java.io.BufferedReader r = new java.io.BufferedReader(
+                        new java.io.FileReader(usbOnline))) {
+                    String s = r.readLine();
+                    if (s == null || !"1".equals(s.trim())) return false;
+                }
+                try (java.io.BufferedReader r = new java.io.BufferedReader(
+                        new java.io.FileReader(batStatus))) {
+                    String s = r.readLine();
+                    if (s == null) return false;
+                    String t = s.trim();
+                    // Charger present but kernel says we're not pulling current
+                    // → FET is open → bypass is engaged.
+                    return "Not charging".equals(t) || "Discharging".equals(t);
+                }
