+            Log.w("LineageHealth", "OPLUS charger HAL not available");
+            return false;
+        }
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken("vendor.oplus.hardware.charger.ICharger");
+            data.writeInt(14);                                   // ChgFuncFlag = smart-limit
+            data.writeString("2++" + (enable ? "1" : "0") + "+" + levelPct);
+            data.writeInt(2);                                    // caller
+            if (!binder.transact(127, data, reply, 0)) {
