+/*
+ * Copyright (C) 2026 The EvolutionX Project
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Pagani Plus Key intercept helpers — used by PhoneWindowManager to redirect
+ * KEYCODE_ASSIST events to the com.oplus.pluskey APK on the OnePlus 13s
+ * "pagani" device. Short presses are dropped, long presses fire a broadcast
+ * that the APK turns into a configured action (sound mode, DND, camera, ...).
+ *
+ * This file is intentionally minimal so the PWM patch (patches/0010 in the
+ * pagani device tree) stays small and reviewable.
+ */
+package com.android.server.policy;
+
+import android.content.Context;
+import android.content.Intent;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.util.Log;
+
+public final class PaganiPlusKey {
+    private static final String TAG = "PaganiPlusKey";
+
+    /** Broadcast action the com.oplus.pluskey receiver listens for. */
+    public static final String ACTION_LONG_PRESS = "com.oplus.pluskey.LONG_PRESS";
+
+    /** Cached so we don't keep stat'ing the property. */
+    private static volatile Boolean sIsPagani;
+
+    private PaganiPlusKey() {}
+
+    /** True if running on the OnePlus 13s pagani device. */
+    public static boolean isPagani() {
+        Boolean cached = sIsPagani;
+        if (cached != null) return cached;
+        // ro.product.device is the OEM SKU (e.g. OP612BL1) on pagani builds,
+        // NOT the codename. Use the LineageOS / EvolutionX device-codename
+        // props which reliably equal "pagani".
+        boolean v = "pagani".equals(SystemProperties.get("ro.lineage.device"))
+                || "pagani".equals(SystemProperties.get("ro.evolution.device"));
+        sIsPagani = v;
+        return v;
+    }
+
+    /** Send the long-press broadcast to the PlusKey APK. */
+    public static void fireLongPress(Context ctx) {
+        try {
+            Intent i = new Intent(ACTION_LONG_PRESS);
+            i.setPackage("com.oplus.pluskey");
+            i.addFlags(Intent.FLAG_INCLUDE_STOPPED_PACKAGES
+                    | Intent.FLAG_RECEIVER_FOREGROUND);
+            ctx.sendBroadcastAsUser(i, UserHandle.CURRENT);
+        } catch (Throwable t) {
+            Log.w(TAG, "fireLongPress failed", t);
+        }
+    }
+}
