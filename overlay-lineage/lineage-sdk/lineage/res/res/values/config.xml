<resources>

    <!-- Hardware keys present on the device, stored as a bit field.
         This integer should equal the sum of the corresponding value for each
         of the following keys present:
            1 - Home
            2 - Back
            4 - Menu
            8 - Assistant (search)
            16 - App switch
            32 - Camera
            64 - Volume rocker
         For example, a device with Home, Back and Menu keys would set this
         config to 7. -->
    <!-- 64 = Volume rocker only. The Assist bit (8) is intentionally OMITTED:
         pagani's Plus Key reports KEYCODE_ASSIST, but its user-facing
         configuration lives on the dedicated "Plus Key" root Settings page
         (PlusKey APK + patches/0009), so the legacy LineageParts "Assist key"
         category in System → Buttons would just be a confusing duplicate.
         The Plus Key long-press dispatch is wired by PWM patch 0010 keying
         off ro.lineage.device, independent of this bitfield. -->
    <integer name="config_deviceHardwareKeys">64</integer>


    <!-- Hardware keys present on the device with the ability to wake, stored as a bit field.
         This integer should equal the sum of the corresponding value for each
         of the following keys present:
             1 - Home
             2 - Back
             4 - Menu
             8 - Assistant (search)
            16 - App switch
            32 - Camera
            64 - Volume rocker
         For example, a device with Home, Back and Menu keys would set this
         config to 7. -->
    <!-- Same reasoning as config_deviceHardwareKeys above. -->
    <integer name="config_deviceHardwareWakeKeys">64</integer>
</resources>
